# =====================================================================
# NeoQuetzal API - Dockerfile VULNERABLE (Entregable 3, Fase 5)
# Se construye con el contexto de la carpeta vulnerable/ del lab:
#   docker build -f docker/Dockerfile.vulnerable -t neoquetzal-api:vulnerable vulnerable/
# =====================================================================

# Imagen base completa (Debian bullseye) y version vieja de Node 22: cientos de CVE del SO
FROM node:22.1.0-bullseye

# Secretos dentro de la imagen (cualquiera que haga "docker history" los ve) - CB-03 / CB-09
ENV JWT_SECRET=neoquetzal-secreto-123 \
    CORE_API_KEY=AKIA4NEOQUETZAL20261 \
    NODE_ENV=development

# Herramientas que no necesita la app (aumentan la superficie de ataque)
RUN apt-get update && apt-get install -y curl wget netcat-traditional openssh-server sudo vim

WORKDIR /app

# ADD en lugar de COPY y se copia todo (incluye .git, .env, pruebas, etc.)
ADD . /app

# Instala tambien dependencias de desarrollo
RUN npm install

EXPOSE 3000 22

# Corre como root y sin HEALTHCHECK
CMD ["sh", "-c", "node --experimental-sqlite db.js && node --experimental-sqlite app.js"]
